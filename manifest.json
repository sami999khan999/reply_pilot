{
  "manifest_version": 3,
  "name": "Reply Pilot",
  "version": "1.0.0",
  "description": "On-device AI reply assistant for WhatsApp Web and Messenger using Chrome's built-in Gemini Nano.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "action": {
    "default_title": "Reply Pilot"
  },
  "background": {
    "service_worker": "src/worker/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*"],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
